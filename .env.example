# The platform start scripts create .env and replace the two local secrets below.
POSTGRES_PASSWORD=replace-on-first-run
ADAPTED_SECRET_KEY=replace-on-first-run

# Optional. Set both Google values and enable the frontend button to use Google sign-in.
ADAPTED_GOOGLE_CLIENT_ID=
ADAPTED_GOOGLE_CLIENT_SECRET=
ADAPTED_GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
VITE_GOOGLE_OAUTH_ENABLED=false

# Optional. Needed for teacher registration; choose a private invite code.
ADAPTED_TEACHER_INVITE_CODE=

# Optional hosted AI and retrieval services. Email/password sign-in works without these.
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_READ_ONLY_API_KEY=

# Local browser/API addresses. If you change ports, update the URLs too.
ADAPTED_WEB_PORT=5173
ADAPTED_API_PORT=8000
ADAPTED_FRONTEND_URL=http://localhost:5173
ADAPTED_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
