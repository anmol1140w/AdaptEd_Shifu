      "chunks": [
        {
          "chunk_id": "chem12-rate-law-explanation-001",
          "book_id": "adapted-chemistry-12",
          "lesson_id": "lesson-chem-12-chemical-kinetics-rate-law",
          "concept_id": "chem-12-chemical-kinetics-rate-law",
          "subject": "Chemistry",
          "class": 12,
          "chapter": "Chemical Kinetics",
          "topic": "Rate laws and reaction order",
          "content_type": "explanation",
          "text": "A rate law expresses how reaction rate depends on reactant concentrations, usually as rate = k[A]^m[B]^n. The exponents are determined experimentally and their sum is the overall order. The rate-law exponents cannot generally be read directly from the balanced equation unless the reaction is an elementary step.",
          "reference_id": "adapted-original-chemistry-12",
          "syllabus_reference_id": "cbse-2026-27-chemistry-043",
          "page_start": null,
          "page_end": null,
