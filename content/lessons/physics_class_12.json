      "chunks": [
        {
          "chunk_id": "phy12-photoelectric-explanation-001",
          "book_id": "adapted-physics-12",
          "lesson_id": "lesson-phy-12-photoelectric-effect",
          "concept_id": "phy-12-photoelectric-effect",
          "subject": "Physics",
          "class": 12,
          "chapter": "Dual Nature of Radiation and Matter",
          "topic": "Photoelectric effect",
          "content_type": "explanation",
          "text": "In the photoelectric effect, light can eject electrons from a material when its frequency exceeds a threshold frequency. Einstein's relation is K_max = hf - φ, where φ is the work function. Increasing intensity at an above-threshold frequency increases the number of emitted electrons, while frequency controls the maximum kinetic energy in the ideal introductory model.",
          "reference_id": "adapted-original-physics-12",
          "syllabus_reference_id": "cbse-2026-27-physics-042",
          "page_start": null,
          "page_end": null,
          "language": "en",
          "review_status": "teacher_review_required"
        },
        {
          "chunk_id": "phy12-photoelectric-example-001",
          "book_id": "adapted-physics-12",
          "lesson_id": "lesson-phy-12-photoelectric-effect",
          "concept_id": "phy-12-photoelectric-effect",
          "subject": "Physics",
          "class": 12,
          "chapter": "Dual Nature of Radiation and Matter",
          "topic": "Photoelectric effect",
          "content_type": "worked_example",
          "text": "If incident photons have energy 5 eV and the material work function is 2 eV, the maximum emitted-electron kinetic energy is 5 - 2 = 3 eV. If photon energy were below 2 eV, emission would not occur in the one-photon model, regardless of intensity.",
          "reference_id": "adapted-original-physics-12",
          "syllabus_reference_id": "cbse-2026-27-physics-042",
          "page_start": null,
          "page_end": null,
          "language": "en",
          "review_status": "teacher_review_required"
