      "chunks": [
        {
          "chunk_id": "phy11-work-energy-explanation-001",
          "book_id": "adapted-physics-11",
          "lesson_id": "lesson-phy-11-work-energy-theorem",
          "concept_id": "phy-11-work-energy-theorem",
          "subject": "Physics",
          "class": 11,
          "chapter": "Work, Energy and Power",
          "topic": "Work-energy theorem",
          "content_type": "explanation",
          "text": "The net work done on an object equals its change in kinetic energy: W_net = ΔK. Positive net work increases kinetic energy; negative net work decreases it. Work depends on the component of force along displacement, so a force perpendicular to displacement does no work in this model.",
          "reference_id": "adapted-original-physics-11",
          "syllabus_reference_id": "cbse-2026-27-physics-042",
          "page_start": null,
          "page_end": null,
