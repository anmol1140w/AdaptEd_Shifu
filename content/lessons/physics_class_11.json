          "concept_id": "phy-11-work-energy-theorem",
          "subject": "Physics",
          "class": 11,
          "chapter": "Work, Energy and Power",
          "topic": "Work-energy theorem",
          "content_type": "worked_example",
          "text": "A 2 kg block speeds up from 2 m/s to 4 m/s. Its kinetic-energy change is (1/2)(2)(4^2 - 2^2) = 12 J. The net work on the block is therefore 12 J.",
