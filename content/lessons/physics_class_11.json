      ],
      "chunks": [
        {
          "chunk_id": "phy-11-velocity-explanation-001",
          "book_id": "adapted-physics-11",
          "lesson_id": "lesson-phy-11-velocity",
          "concept_id": "phy-11-velocity",
          "subject": "Physics",
          "class": 11,
          "chapter": "Motion in a Straight Line",
          "topic": "Average and instantaneous velocity",
          "content_type": "explanation",
