          "concept_id": "phy-11-friction",
          "subject": "Physics",
          "class": 11,
          "chapter": "Laws of Motion",
          "topic": "Static and kinetic friction",
          "content_type": "explanation",
          "text": "Friction acts parallel to a contact surface and opposes relative motion or its tendency. Static friction adjusts up to a maximum value; kinetic friction acts when surfaces slide. The simple dry-friction model uses f_s ≤ μ_s N and f_k = μ_k N.",
          "reference_id": "adapted-original-physics-11",
          "syllabus_reference_id": "cbse-2026-27-physics-042",
          "page_start": null,
          "page_end": null,
