          "lesson_id": "lesson-phy-11-friction",
          "concept_id": "phy-11-friction",
          "subject": "Physics",
          "class": 11,
          "chapter": "Laws of Motion",
          "topic": "Static and kinetic friction",
          "content_type": "misconception",
          "text": "Static friction is not always equal to μ_sN; that value is its maximum in this model.",
          "reference_id": "adapted-original-physics-11",
