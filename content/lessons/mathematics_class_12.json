      "chunks": [
        {
          "chunk_id": "math12-integral-explanation-001",
          "book_id": "adapted-mathematics-12",
          "lesson_id": "lesson-math-12-definite-integrals",
          "concept_id": "math-12-definite-integrals",
          "subject": "Mathematics",
          "class": 12,
          "chapter": "Integrals",
          "topic": "Definite integrals and symmetry",
          "content_type": "explanation",
          "text": "A definite integral accumulates signed area over an interval and can be evaluated using an antiderivative: ∫_a^b f(x)dx = F(b) - F(a). Symmetry can simplify integrals: for an even function, ∫_-a^a f(x)dx = 2∫_0^a f(x)dx; for an odd function the integral over symmetric limits is zero. Check the function's parity before applying these properties.",
          "reference_id": "adapted-original-mathematics-12",
          "syllabus_reference_id": "cbse-2026-27-mathematics-041",
          "page_start": null,
          "page_end": null,
          "language": "en",
          "review_status": "teacher_review_required"
        },
        {
          "chunk_id": "math12-integral-example-001",
