      "chunks": [
        {
          "chunk_id": "chem11-equilibrium-explanation-001",
          "book_id": "adapted-chemistry-11",
          "lesson_id": "lesson-chem-11-chemical-equilibrium",
          "concept_id": "chem-11-chemical-equilibrium",
          "subject": "Chemistry",
          "class": 11,
          "chapter": "Equilibrium",
          "topic": "Dynamic equilibrium and Le Chatelier's principle",
          "content_type": "explanation",
          "text": "At dynamic equilibrium in a closed system, forward and reverse reaction rates are equal, so concentrations remain constant over time. The concentrations need not be equal. A disturbance such as a concentration or temperature change can shift the position of equilibrium; the equilibrium constant changes with temperature, not simply because more reactant was added.",
          "reference_id": "adapted-original-chemistry-11",
          "syllabus_reference_id": "cbse-2026-27-chemistry-043",
          "page_start": null,
          "page_end": null,
