      "chunks": [
        {
          "chunk_id": "chem11-periodic-explanation-001",
          "book_id": "adapted-chemistry-11",
          "lesson_id": "lesson-chem-11-periodic-trends",
          "concept_id": "chem-11-periodic-trends",
          "subject": "Chemistry",
          "class": 11,
          "chapter": "Classification of Elements and Periodicity",
          "topic": "Atomic radius and ionization enthalpy trends",
          "content_type": "explanation",
          "text": "Across a period, effective nuclear charge generally increases while electrons enter the same principal shell, so atomic radius generally decreases. Down a group, additional electron shells generally make atoms larger. Ionization enthalpy generally increases across a period and decreases down a group, with exceptions caused by subshell structure and electron pairing.",
          "reference_id": "adapted-original-chemistry-11",
          "syllabus_reference_id": "cbse-2026-27-chemistry-043",
          "page_start": null,
          "page_end": null,
