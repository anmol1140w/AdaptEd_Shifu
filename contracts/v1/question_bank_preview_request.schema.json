{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adapted.example/contracts/v1/question_bank_preview_request.schema.json",
  "title": "Question bank preview request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "records"],
  "properties": {
    "contract_version": { "const": "v1" },
    "records": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/question" } }
  },
  "$defs": {
    "question": {
      "type": "object",
      "required": ["question", "question_type", "subject", "topic"],
      "properties": {
        "question": { "type": "string", "minLength": 1 },
        "question_type": { "enum": ["mcq", "numerical", "short_answer", "descriptive", "coding"] },
        "correct_answer": { "type": "string" },
        "difficulty": { "enum": ["easy", "medium", "hard"] },
        "bloom_level": { "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 6 }, { "enum": ["BT1", "BT2", "BT3", "BT4", "BT5", "BT6"] }] },
        "subject": { "type": "string", "minLength": 1 },
        "topic": { "type": "string", "minLength": 1 },
        "marks": { "type": "number", "exclusiveMinimum": 0 },
        "time_seconds": { "type": "integer", "minimum": 1 },
        "explanation": { "type": "string" },
        "option_a": { "type": "string" }, "option_b": { "type": "string" },
        "option_c": { "type": "string" }, "option_d": { "type": "string" },
        "correct_option": { "type": "string" }, "rubric": { "type": "string" },
        "marking_rubric": { "type": "string" }, "test_cases": {},
        "input_format": { "type": "string" }, "output_format": { "type": "string" },
        "constraints": { "type": "string" }, "sample_input": {}, "sample_output": {}
      },
      "additionalProperties": true
    }
  }
}
