{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adapted/contracts/v1/subject_summary_response",
  "title": "Subject summary response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "learner_id",
    "subject",
    "summary",
    "concepts"
  ],
  "properties": {
    "contract_version": {
      "const": "v1"
    },
    "learner_id": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/concept_summary"
      }
    }
  },
  "$defs": {
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mastery_score",
        "confidence",
        "evidence_count",
        "concept_count",
        "assessed_concept_count",
        "gap_status_counts"
      ],
      "properties": {
        "mastery_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence_count": {
          "type": "integer",
          "minimum": 0
        },
        "concept_count": {
          "type": "integer",
          "minimum": 1
        },
        "assessed_concept_count": {
          "type": "integer",
          "minimum": 0
        },
        "gap_status_counts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gap_status_count"
          }
        }
      }
    },
    "gap_status_count": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "count"],
      "properties": {
        "status": {
          "enum": [
            "not_enough_evidence",
            "prerequisite_blocked",
            "needs_support",
            "developing",
            "fragile",
            "secure"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "concept_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concept",
        "mastery",
        "gap_status",
        "recommendation",
        "evidence"
      ],
      "properties": {
        "concept": {
          "$ref": "#/$defs/concept"
        },
        "mastery": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": [
            "concept_id",
            "score",
            "confidence",
            "evidence_count",
            "trend",
            "likely_misconception",
            "recent_correctness",
            "independence_score"
          ],
          "properties": {
            "concept_id": {
              "type": "string",
              "minLength": 1
            },
            "score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "evidence_count": {
              "type": "integer",
              "minimum": 0
            },
            "trend": {
              "enum": [
                "insufficient_evidence",
                "improving",
                "stable",
                "declining"
              ]
            },
            "likely_misconception": {
              "type": ["string", "null"],
              "minLength": 1
            },
            "recent_correctness": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "independence_score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "gap_status": {
          "enum": [
            "not_enough_evidence",
            "prerequisite_blocked",
            "needs_support",
            "developing",
            "fragile",
            "secure"
          ]
        },
        "recommendation": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": [
            "action_type",
            "target_concept_id",
            "reason",
            "evidence_reference_ids",
            "teacher_review_required"
          ],
          "properties": {
            "action_type": {
              "enum": [
                "baseline_check",
                "prerequisite_support",
                "targeted_practice",
                "transfer_practice"
              ]
            },
            "target_concept_id": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "evidence_reference_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "teacher_review_required": {
              "type": "boolean"
            }
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subject_id",
        "name",
        "prerequisite_ids",
        "mastery_threshold"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "prerequisite_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mastery_threshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "item_id",
        "concept_id",
        "is_correct",
        "difficulty",
        "hint_count",
        "response_ms",
        "confidence_signal",
        "misconception"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "item_id": {
          "type": "string",
          "minLength": 1
        },
        "concept_id": {
          "type": "string",
          "minLength": 1
        },
        "is_correct": {
          "type": "boolean"
        },
        "difficulty": {
          "enum": ["easy", "medium", "hard"]
        },
        "hint_count": {
          "type": "integer",
          "minimum": 0
        },
        "response_ms": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "confidence_signal": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "misconception": {
          "type": ["string", "null"],
          "minLength": 1
        }
      }
    }
  }
}
