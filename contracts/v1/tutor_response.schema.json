{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adapted/contracts/v1/tutor_response",
  "title": "Tutor support response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "learner_id",
    "subject_id",
    "concept_id",
    "mode",
    "message",
    "check_question",
    "source_ids",
    "confidence",
    "teacher_review_required",
    "answer_revealed",
    "fallback_used",
    "provider",
    "audit_event_id"
  ],
  "properties": {
    "contract_version": {
      "const": "v1"
    },
    "learner_id": {
      "type": "string",
      "minLength": 1
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "concept_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": ["hint", "explanation", "check_question"]
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "check_question": {
      "type": "string",
      "minLength": 1
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "teacher_review_required": {
      "type": "boolean"
    },
    "answer_revealed": {
      "type": "boolean"
    },
    "fallback_used": {
      "type": "boolean"
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "audit_event_id": {
      "type": "string",
      "minLength": 1
    }
  }
}
