{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adapted/contracts/v1/teacher_intervention_queue_response",
  "title": "Teacher intervention queue response",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "subject", "interventions"],
  "properties": {
    "contract_version": {"const": "v1"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1}
      }
    },
    "interventions": {
      "type": "array",
      "items": {"$ref": "#/$defs/intervention"}
    }
  },
  "$defs": {
    "intervention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "learner_id",
        "subject_id",
        "concept",
        "priority",
        "gap_status",
        "action_type",
        "reason",
        "teacher_review_required",
        "mastery",
        "evidence_reference_ids",
        "evidence_count",
        "repeated_error_count",
        "average_hint_count",
        "evidence"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "learner_id": {"type": "string", "minLength": 1},
        "subject_id": {"type": "string", "minLength": 1},
        "concept": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "subject_id", "name", "prerequisite_ids"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "subject_id": {"type": "string", "minLength": 1},
            "name": {"type": "string", "minLength": 1},
            "prerequisite_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        },
        "priority": {"enum": ["high", "medium", "low"]},
        "gap_status": {
          "enum": ["not_enough_evidence", "prerequisite_blocked", "needs_support", "developing", "fragile", "secure"]
        },
        "action_type": {"enum": ["baseline_check", "prerequisite_support", "targeted_practice", "transfer_practice"]},
        "reason": {"type": "string", "minLength": 1},
        "teacher_review_required": {"type": "boolean"},
        "mastery": {
          "anyOf": [
            {"$ref": "#/$defs/mastery"},
            {"type": "null"}
          ]
        },
        "evidence_reference_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "evidence_count": {"type": "integer", "minimum": 0},
        "repeated_error_count": {"type": "integer", "minimum": 0},
        "average_hint_count": {"type": "number", "minimum": 0},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "mastery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concept_id", "score", "confidence", "evidence_count", "trend", "likely_misconception", "recent_correctness", "independence_score"],
      "properties": {
        "concept_id": {"type": "string", "minLength": 1},
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_count": {"type": "integer", "minimum": 0},
        "trend": {"enum": ["insufficient_evidence", "improving", "stable", "declining"]},
        "likely_misconception": {"type": ["string", "null"], "minLength": 1},
        "recent_correctness": {"type": "number", "minimum": 0, "maximum": 1},
        "independence_score": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "item_id", "concept_id", "is_correct", "difficulty", "hint_count", "misconception"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "item_id": {"type": "string", "minLength": 1},
        "concept_id": {"type": "string", "minLength": 1},
        "is_correct": {"type": "boolean"},
        "difficulty": {"enum": ["easy", "medium", "hard"]},
        "hint_count": {"type": "integer", "minimum": 0},
        "misconception": {"type": ["string", "null"], "minLength": 1}
      }
    }
  }
}
