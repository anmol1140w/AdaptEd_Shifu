{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adapted/contracts/v1/tutor_request",
  "title": "Tutor support request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "learner_id",
    "subject_id",
    "concept_id",
    "mode"
  ],
  "properties": {
    "contract_version": {
      "const": "v1"
    },
    "learner_id": {
      "type": "string",
      "minLength": 1
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "concept_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": ["hint", "explanation", "check_question"]
    },
    "learner_answer": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "misconception": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "learner_level": {
      "type": "string",
      "minLength": 1
    }
  }
}
