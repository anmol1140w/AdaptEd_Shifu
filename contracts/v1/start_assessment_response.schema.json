{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adapted/contracts/v1/start_assessment_response",
  "title": "Start assessment response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "subject",
    "session",
    "concept",
    "item"
  ],
  "properties": {
    "contract_version": {
      "const": "v1"
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "session": {
      "$ref": "#/$defs/session"
    },
    "concept": {
      "$ref": "#/$defs/concept"
    },
    "item": {
      "$ref": "#/$defs/item"
    }
  },
  "$defs": {
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "learner_id",
        "subject_id",
        "current_concept_id",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "learner_id": {
          "type": "string",
          "minLength": 1
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "current_concept_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "active",
            "completed",
            "cancelled"
          ]
        }
      }
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subject_id",
        "name",
        "prerequisite_ids",
        "mastery_threshold"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "prerequisite_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mastery_threshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subject_id",
        "concept_id",
        "difficulty",
        "question"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "concept_id": {
          "type": "string",
          "minLength": 1
        },
        "difficulty": {
          "enum": [
            "easy",
            "medium",
            "hard"
          ]
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    }
  }
}
