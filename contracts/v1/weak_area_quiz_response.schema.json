{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adapted/contracts/v1/weak_area_quiz_response",
  "title": "Weak-area quiz response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "learner_id",
    "subject_id",
    "concept",
    "difficulty",
    "items",
    "source_ids",
    "confidence",
    "teacher_review_required",
    "fallback_used",
    "provider",
    "audit_event_id"
  ],
  "properties": {
    "contract_version": {
      "const": "v1"
    },
    "learner_id": {
      "type": "string",
      "minLength": 1
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "concept": {
      "$ref": "#/$defs/concept"
    },
    "difficulty": {
      "enum": ["easy", "medium", "hard"]
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "teacher_review_required": {
      "type": "boolean"
    },
    "fallback_used": {
      "type": "boolean"
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "audit_event_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subject_id", "name", "prerequisite_ids"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "prerequisite_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subject_id",
        "concept_id",
        "difficulty",
        "question",
        "representation",
        "source_ids",
        "is_transfer"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "concept_id": {
          "type": "string",
          "minLength": 1
        },
        "difficulty": {
          "enum": ["easy", "medium", "hard"]
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "representation": {
          "enum": ["symbolic", "verbal", "story"]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "is_transfer": {
          "type": "boolean"
        }
      }
    }
  }
}
